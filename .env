# ==================== 智学伴侣 环境变量配置 ====================
# 演示模式：以下配置保持注释（留空）时，程序自动进入演示模式，
# 所有 AI 回复均使用内置模拟数据，无需真实调用接口即可体验完整流程。

# OpenAI API 密钥（配置后退出演示模式，开始真实调用大模型）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容接口地址（可选，默认官方地址；使用第三方/本地部署服务时修改）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 多模态模型名（用于错题图片识别与解析）
# MODEL_NAME=gpt-4o-mini

# 对话模型名（用于学习伴侣聊天、画像提取、资源推荐；不填则复用 MODEL_NAME）
# CHAT_MODEL_NAME=gpt-4o-mini

OPENAI_API_KEY=648759f2e7c44b41a76cfdee9fd4a870.65CvnyckCRCjy25j
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-5.3-flash
CHAT_MODEL_NAME=glm-5.3-flash
